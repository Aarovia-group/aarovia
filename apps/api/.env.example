# ===========================================
# AAROVIA CRM - API ENVIRONMENT VARIABLES
# ===========================================

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/aarovia_crm?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Outbound email is configured in CRM Settings with the Zoho Mail SMTP credentials.
# Aarovia's Zoho India SMTP host is smtp.zoho.in (port 465 SSL or 587 STARTTLS).

# Cloudinary (Image/File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# WhatsApp provider: META (default) or TWILIO.
# Set this only when provider selection should be locked in the environment.
# WHATSAPP_PROVIDER=META

# Meta WhatsApp Cloud API
# Setup: developers.facebook.com → Create App → WhatsApp → Get Credentials
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Optional Twilio WhatsApp provider
# Set WHATSAPP_PROVIDER=TWILIO to select or lock Twilio.
# Provide either TWILIO_AUTH_TOKEN or the API key SID/secret pair.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
# TWILIO_PHONE_NUMBER=+12345678900
# TWILIO_SMS_PHONE_NUMBER=+12345678900
# TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 (Alternative to Cloudinary)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=aarovia-crm-documents

# Redis (Optional - for caching/sessions)
# REDIS_URL=redis://localhost:6379
