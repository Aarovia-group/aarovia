# ===========================================
# AAROVIA CRM - API ENVIRONMENT VARIABLES
# ===========================================

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/aarovia_crm?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Gmail SMTP (App Password - NOT your Gmail password)
# Setup: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Alternate SMTP provider (SendGrid, Mailgun, SMTP relay, etc.)
# Use either Gmail or SMTP_* settings. SMTP_HOST takes precedence.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# Cloudinary (Image/File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# WhatsApp Cloud API
# Setup: developers.facebook.com → Create App → WhatsApp → Get Credentials
# In Settings, configure this provider separately from Twilio WhatsApp.
# Set WHATSAPP_PROVIDER only to lock provider selection; otherwise select a provider in Settings.
# WHATSAPP_PROVIDER=META
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Twilio WhatsApp (optional; configure separately in Settings)
# WHATSAPP_PROVIDER=TWILIO
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Or use an API key pair instead of TWILIO_AUTH_TOKEN:
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
# TWILIO_PHONE_NUMBER=+12345678900
# TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio SMS (optional; configure in CRM Settings → SMS (Twilio), or set these)
# SMS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Or use an API key pair instead of SMS_TWILIO_AUTH_TOKEN:
# SMS_TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
# SMS_TWILIO_PHONE_NUMBER=+12345678900
# Or use a Twilio Messaging Service SID instead of a direct sender number:
# SMS_TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Existing TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and TWILIO_API_KEY_* settings
# can provide SMS authentication, but TWILIO_PHONE_NUMBER is not used as an SMS sender.

# AWS S3 (Alternative to Cloudinary)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=aarovia-crm-documents

# Redis (Optional - for caching/sessions)
# REDIS_URL=redis://localhost:6379
